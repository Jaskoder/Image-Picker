{
  "name": "Image Picker",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "./popups/index.html",
    "default_icon": "./images/icon.png"
  },
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "https://*/*",
        "https://developer.chrome.com/docs/webstore/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
